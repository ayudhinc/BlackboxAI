# Copy to .env and fill in. .env is gitignored; never commit real values.

# Meta Model API (https://dev.meta.ai). Create the key yourself.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Local Postgres from docker-compose.yml (port 5476, registered in ~/dev/ports.md).
DATABASE_URL=postgres://blackbox:blackbox@127.0.0.1:5476/blackbox

# Ports (registered in ~/dev/ports.md)
WEB_PORT=3500
WORKER_HEALTH_PORT=3502

# Auth (web). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3500

# Hosted spend guard: new verifications pause once 24-hour spend reaches this.
DAILY_BUDGET_USD=10

# Cloudflare R2 (production). Local development stores files in .data/blobs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Development stores on local disk even when the R2 keys above are set; BLOB_STORE=r2 opts in.
# Production always uses R2.
