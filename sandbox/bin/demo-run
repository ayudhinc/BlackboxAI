#!/usr/bin/env bash
# Start the CRM, the browser and the agent console strip, then run one scripted
# demo task. Native tasks also start the runtime event listener.
# Usage: demo-run <D01..D09> [label]
set -euo pipefail
id="${1:?usage: demo-run <task id> [label]}"
label="${2:-$id}"

PORT=80 node /opt/blackbox/apps/crm/server.ts >/tmp/crm.log 2>&1 &
# Remote-desktop tasks: the noVNC viewer bridges to the Meridian container's VNC server.
if [[ "$id" =~ ^D1[0-2]$ ]]; then
  websockify --web /usr/share/novnc 0.0.0.0:6080 meridian:5900 >/tmp/websockify.log 2>&1 &
fi
for _ in $(seq 1 50); do curl -sf http://crm.acme.test/__console/state >/dev/null && break; sleep 0.1; done

# Native runs: the runtime listener starts first, so the AT-SPI registry is up before Chromium.
if [[ "$id" == "D03" || "$id" == "D08" ]]; then
  python3 /opt/blackbox/runtime/atspi_listener.py "/recordings/${label}.runtime.jsonl" >/tmp/atspi.log 2>&1 &
  sleep 1.5
fi

chromium --no-sandbox --disable-infobars --no-first-run --no-default-browser-check \
  --disable-features=Translate,HttpsUpgrades,HttpsFirstBalancedModeAutoEnable,PasswordManagerOnboarding \
  --force-renderer-accessibility --remote-debugging-port=9222 \
  --window-position=0,0 --window-size="${SCREEN_W},$((SCREEN_H - 40))" \
  --user-data-dir=/tmp/chrome-main "about:blank" </dev/null >/tmp/chromium.log 2>&1 &
chromium --no-sandbox --disable-infobars --no-first-run --no-default-browser-check \
  --window-position=0,$((SCREEN_H - 40)) --window-size="${SCREEN_W},40" \
  --user-data-dir=/tmp/chrome-console --app="http://crm.acme.test/__console" </dev/null >/tmp/console.log 2>&1 &
for _ in $(seq 1 100); do curl -sf http://127.0.0.1:9222/json/version >/dev/null && break; sleep 0.1; done
sleep 2


node /opt/blackbox/runner/run.ts "$id" "$label"
