#!/usr/bin/env bash
# Stop an ffmpeg started by `record` and wait for it to finalise the file.
# Usage: stop-recording <pid>
set -euo pipefail
pid="${1:?usage: stop-recording <pid>}"
kill -INT "$pid"
for _ in $(seq 1 100); do kill -0 "$pid" 2>/dev/null || exit 0; sleep 0.1; done
echo "stop-recording: ffmpeg $pid did not exit" >&2
cat /tmp/ffmpeg.log >&2
exit 1
