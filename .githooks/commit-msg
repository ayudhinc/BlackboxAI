#!/bin/sh
# Reject commit messages carrying AI / tool attribution. Author every commit as
# a person; see ~/.claude/CLAUDE.md (Git).
msg="$1"
pattern='Co-Authored-By:.*(Claude|Anthropic|noreply@anthropic\.com)|Generated with \[?Claude Code|claude\.com/claude-code|🤖'
if grep -Eiq "$pattern" "$msg"; then
  echo "commit-msg: AI attribution is not allowed in commit messages." >&2
  echo "  Remove the Co-Authored-By / 'Generated with Claude Code' line and retry." >&2
  grep -Ein "$pattern" "$msg" | sed 's/^/  > /' >&2
  exit 1
fi
